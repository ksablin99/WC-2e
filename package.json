{
  "name": "foundryvtt-warcraft-rpg-2e",
  "private": true,
  "author": {
    "name": "Antoni Sobkowicz"
  },
  "scripts": {
    "build:release": "webpack",
    "build:foundry-dice": "node test/build-foundry-dice.mjs",
    "prepare:classic-level": "node scripts/prepare-classic-level.js",
    "pretest": "npm run prepare:classic-level",
    "test": "jest --config jest.config.js",
    "test:foundry": "npm run build:foundry-dice && jest --config jest.foundry.config.js",
    "test:ci": "jest --config jest.config.js --reporters=default --reporters=jest-junit",
    "test:foundry-ci": "npm run build:foundry-dice && jest --config jest.foundry.config.js --reporters=default --reporters=jest-junit",
    "e2e:setup": "node test/e2e/setup.js",
    "e2e:release-setup": "node scripts/e2e-release-setup.js",
    "e2e:clean": "node scripts/e2e-clean.js",
    "test:e2e": "npm run e2e:setup && playwright test",
    "test:e2e-release": "npm run e2e:release-setup && playwright test",
    "test:e2e-ci": "npm run e2e:setup && playwright test --reporter=junit",
    "dev:setup": "node scripts/dev-setup.js",
    "dev:start": "node scripts/dev-start.js",
    "dev:clean": "node scripts/dev-clean.js",
    "srd:setup": "node scripts/srd-setup.js",
    "prepare-release": "node utils/prepare-release.js",
    "presources:repack": "npm run prepare:classic-level",
    "sources:repack": "node utils/repack.js",
    "presources:unpack": "npm run prepare:classic-level",
    "sources:unpack": "node utils/unpack.js",
    "presources:query": "npm run prepare:classic-level",
    "sources:query": "node utils/query-pack.js",
    "presources:compact": "npm run prepare:classic-level",
    "sources:compact": "node utils/compact-pack.js",
    "i18n:check": "node utils/i18n-check.js --verbose --system-only",
    "i18n:check-ci": "node utils/i18n-check.js --system-only",
    "i18n:fill": "node utils/i18n-check.js --fill --suggest --system-only",
    "wt:create": "node scripts/wt-create.js",
    "wt:list": "node scripts/wt-list.js",
    "wt:switch": "node scripts/wt-switch.js",
    "wt:remove": "node scripts/wt-remove.js",
    "wt:cleanup": "node scripts/wt-cleanup.js",
    "wt:close": "node scripts/wt-close.js",
    "wt:home": "node scripts/wt-home.js",
    "wt:up": "node scripts/wt-up.js",
    "wt:here": "node scripts/wt-here.js",
    "wt:ai": "node scripts/wt-ai.js",
    "wt:colors": "node scripts/wt-colors.js",
    "pack:system": "node utils/pack-system.js",
    "css": "gulp css",
    "css:watch": "gulp"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.22.20",
    "@babel/register": "^7.22.15",
    "@playwright/test": "^1.58.2",
    "chai": "^4.3.8",
    "classic-level": "^3.0.0",
    "color": "^3.1.2",
    "esbuild": "^0.27.4",
    "fs-extra": "^9.0.0",
    "gulp": "^4.0.2",
    "gulp-less": "^4.0.1",
    "gulp-stream": "0.0.2",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-teamcity": "^1.11.0",
    "mocha": "^10.2.0",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-teamcity-reporter": "^4.2.0",
    "open": "^11.0.0",
    "prettier": "2.7.1",
    "proxyquire": "^2.1.3",
    "sinon": "^16.0.0",
    "terser-webpack-plugin": "^3.0.2",
    "webpack": "^4.43.0",
    "webpack-cli": "^3.3.11"
  },
  "dependencies": {
    "sort-json": "^2.0.1"
  }
}
