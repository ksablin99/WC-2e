    "deathRule": "forsaken",
    "description": {
      "chat": "",
      "unidentified": "",
      "value": "<p>Free-willed undead with a distinct damage-and-death track.</p><ul><li>+2 Strength, -2 Agility; Medium; land speed 30 feet; darkvision 60 feet.</li><li>No Stamina score; Charisma modifies Concentration.</li><li>Undead immunities, no natural healing, negative energy heals, positive energy harms.</li><li>Disabled at 0 hit points, down from -1 through -9, destroyed at -10.</li><li>Common plus Goblin, Low Common, Orc, or Thalassian; favored class Warrior.</li><li>May take up to three Forsaken racial levels; advanced undead interactions remain descriptive in this slice.</li></ul>"
    },
