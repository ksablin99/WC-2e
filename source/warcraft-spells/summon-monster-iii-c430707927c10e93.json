    "description": {
      "chat": "",
      "unidentified": "",
      "value": "<div class=\"spell-description\">\n  <p>\n      <strong>School:</strong>&nbsp;conjuration&nbsp;(summoning)&nbsp;[see text for summon monster i];\n    <br>\n    <strong>Level:</strong>&nbsp;Bard 3, Blackguard 3, Cleric 3, Sorcerer 3, Wizard 3;\n    \n    \n    \n    \n    <br>\n    \n    \n      <strong>Casting Time:</strong>&nbsp;1 round<br>\n    <strong>Range:</strong>&nbsp;touch<br>\n    \n    \n    <strong>Effect:</strong>&nbsp;One or more summoned creatures, no two of which can be more than 30 ft. apart<br>\n    <strong>Duration:</strong>&nbsp;Instantaneous<br>\n    \n        <strong>Saving Throw:</strong>&nbsp;none\n        <br>\n        <strong>Spell Resistance:</strong>&nbsp;no<br>\n  </p>\n  <h2>Description</h2>\n  <p><span style=\"font-family: var(--font-primary); font-size: var(--font-size-14);\">This spell functions like @Compendium[warcraftrpg2e.spells.eEyDI6q41iGOabdX]{Summon Monster I}</span><em>, </em>except that you can summon one creature from the 3rd-level list, 1d3 creatures of the same kind from the 2nd-level list, or 1d4+1 creatures of the same kind from the 1st-level list.</p>\n<h3><span id=\"Summon_Monster_Tables\" class=\"mw-headline\">Summon Monster Tables</span></h3>\n<p><span class=\"mw-headline\">@Compendium[warcraftrpg2e.summoning-roll-tables.qLwD4yuvOMTUSxsH]{Summon Monster I}</span></p>\n<p><span class=\"mw-headline\">@Compendium[warcraftrpg2e.summoning-roll-tables.eGFaIIrrtY72kLaa]{Summon Monster II}</span></p>\n<p><span class=\"mw-headline\">@Compendium[warcraftrpg2e.summoning-roll-tables.EvlMyU1vcdEFVr6l]{Summon Monster III}</span></p>\n</div>\n"
    },
