# IDE
.idea/
.vs/
.vscode/
*.code-workspace

# Cursor — local IDE/agent data (mcp.json, logs, caches). Shared rules stay tracked.
.cursor/*
!.cursor/rules/
!.cursor/rules/**
# Cursor Memory Bank / similar project-root agent memory (session context; do not commit)
/memory-bank/

# Node Modules
node_modules/
/test-scripts
/tokens
source/*.json
icons/
dnd35e.zip
.venv/
packs/

*.zip

*.logoist

add-foundry-release.sh

.DS_Store
dnd35e-icons.tbz2
/junit.xml

.foundrycache

# Private rules references; never publish book PDFs or extracted page assets.
docs/*.pdf
tmp/pdfs/
.foundry
.foundryuserdata

# D&D 3.5e SRD — downloaded by npm run srd:setup
.srd/
.srd.zip
scratch/

*.local.json

# Generated by test/build-foundry-dice.mjs — compiled at test time, never commit
test/foundry-compiled/

# Generated by e2e:setup — contains local paths, never commit
.e2e-env

# Generated by dev:setup — contains local paths, never commit
.dev-env

# Generated by wt:create — worktree metadata, never commit
.wt-meta

# Persists the chosen Foundry major version across sessions — local only, never commit
.foundry-version

# Foundry license — copy to repo root for local e2e setup, never commit
/license.json

# Playwright output
test-results/
.playwright-mcp/

.claude/worktrees/

companion/

debug.log

